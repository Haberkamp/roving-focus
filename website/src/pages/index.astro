---
import "../styles.css";
import "../font.css";

import { InstallSnippet } from "../components/InstallSnippet";
import { GridExample } from "../components/GridExample";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Let users move through a list or grid of items using arrow keys."
    />
    <title>Roving Focus</title>
  </head>
  <body class="selection:bg-black selection:text-white bg-[#FFFCF5]">
    <div class="container min-h-screen grid place-items-center">
      <div
        class="py-48 lg:py-0 grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-32 lg:gap-0 justify-items-center lg:justify-items-start lg:justify-between w-full"
      >
        <div class="max-w-[410px]">
          <h1 class="text-4xl font-black text-[64px]/[1.1]">Roving Focus</h1>

          <div class="pt-4"></div>

          <p class="text-2xl/[1.3]">
            Let users move through a list or grid of items using arrow keys.
          </p>

          <div class="pt-12"></div>

          <InstallSnippet className="w-full" client:load />
        </div>

        <div>
          <GridExample client:load />
        </div>
      </div>
    </div>
  </body>
</html>
