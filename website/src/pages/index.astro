---
import "../styles/global.css";
import BrowserWindow from "../components/BrowserWindow.astro";
import { GridDemo } from "../components/GridDemo";
import { HorizontalDemo } from "../components/HorizontalDemo";
import InstallSnippet from "../components/InstallSnippet.astro";
import { ListDemo } from "../components/ListDemo";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Roving Focus</title>
  </head>
  <body>
    <main class="mx-auto mt-32 w-full max-w-xl px-6">
      <h1 class="font-medium">Roving Focus</h1>
      <div class="mt-6">
        <InstallSnippet />
      </div>
      <div class="mt-16 flex flex-col gap-24">
        <section>
          <h2 class="font-medium">Lorem ipsum dolor</h2>
          <p class="mt-2 text-neutral-500">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
            eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim
            ad minim veniam, quis nostrud exercitation.
          </p>
          <BrowserWindow class="mt-8">
            <ListDemo client:load />
          </BrowserWindow>
        </section>
        <section>
          <h2 class="font-medium">Sed ut perspiciatis</h2>
          <p class="mt-2 text-neutral-500">
            Sed ut perspiciatis unde omnis iste natus error sit voluptatem
            accusantium doloremque laudantium, totam rem aperiam, eaque ipsa
            quae ab illo inventore veritatis.
          </p>
          <BrowserWindow class="mt-8">
            <HorizontalDemo client:load />
          </BrowserWindow>
        </section>
        <section>
          <h2 class="font-medium">Nemo enim ipsam</h2>
          <p class="mt-2 text-neutral-500">
            Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut
            fugit, sed quia consequuntur magni dolores eos qui ratione
            voluptatem sequi nesciunt.
          </p>
          <BrowserWindow class="mt-8">
            <GridDemo client:load />
          </BrowserWindow>
        </section>
      </div>
    </main>
    <footer class="mx-auto mt-32 mb-16 flex w-full max-w-xl justify-between px-6 text-neutral-500">
      <p>
        Made by{" "}
        <a
          href="https://x.com/n_haberkamp"
          class="text-neutral-900 underline decoration-neutral-300 decoration-dashed underline-offset-4 hover:decoration-neutral-900 rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-300"
        >
          Nils Haberkamp
        </a>
      </p>
      <a
        href="https://github.com/Haberkamp/roving-focus"
        class="text-neutral-900 underline decoration-neutral-300 decoration-dashed underline-offset-4 hover:decoration-neutral-900 rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime-300"
      >
        GitHub
      </a>
    </footer>
  </body>
</html>
