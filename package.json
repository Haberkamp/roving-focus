{
  "name": "@roving-focus/react",
  "version": "2.0.0",
  "description": "A roving focus component for React.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest",
    "dev": "tsc --project tsconfig.build.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "react",
    "typescript",
    "component"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.3",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haberkamp/roving-focus.git"
  }
}
